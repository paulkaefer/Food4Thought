# Database (Vercel Postgres / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/food4thought"

# Vercel Blob (photo storage)
BLOB_READ_WRITE_TOKEN="replace-with-vercel-blob-token"

# Inngest (durable background jobs)
INNGEST_EVENT_KEY="replace-with-inngest-event-key"
INNGEST_SIGNING_KEY="replace-with-inngest-signing-key"

# Nutrition data providers
USDA_FDC_API_KEY="replace-with-usda-fooddata-central-api-key"

# Restaurant nutrition provider (vendor-agnostic; concrete vendor is deployment config)
RESTAURANT_NUTRITION_API_KEY=""
RESTAURANT_NUTRITION_API_BASE_URL=""

# Vision/food-recognition provider (vendor-agnostic; concrete vendor is deployment config)
FOOD_VISION_API_KEY=""
FOOD_VISION_API_BASE_URL=""

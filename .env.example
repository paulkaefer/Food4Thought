# Database (PostgreSQL) — REQUIRED
DATABASE_URL="postgresql://user:password@localhost:5432/food4thought"

# Local meal-photo storage — REQUIRED
# Directory where uploaded meal photos are stored. Photos are private, so this
# directory MUST be outside the Next.js public/ directory. Relative paths
# resolve from the project root; the directory is created automatically on
# first upload (see README setup). data/ is git-ignored.
PHOTO_STORAGE_DIR="./data/photos"

# Admin review UI — OPTIONAL
# Shared token that enables the /admin/food-mappings review UI. Leave empty to
# keep admin review disabled (no publicly accessible review endpoints).
ADMIN_REVIEW_TOKEN=""

# Inngest (durable background jobs) — OPTIONAL for local development
# Required only when running against real Inngest Cloud; the local Inngest dev
# server (npx inngest-cli dev) works without these.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# USDA FoodData Central — REQUIRED for real nutrition data
# Without a key, nutrition falls back to labeled approximate estimates or
# "unavailable" instead of live USDA lookups.
USDA_FDC_API_KEY="replace-with-usda-fooddata-central-api-key"

# AI providers — OPTIONAL (deterministic stubs, no external calls, when unset)
# Set VISION_PROVIDER=openai for real photo analysis.
VISION_PROVIDER=""
# Set USDA_MATCH_SELECTOR=openai for AI-assisted USDA match selection.
USDA_MATCH_SELECTOR=""
OPENAI_API_KEY=""
OPENAI_VISION_MODEL=""
OPENAI_MATCH_MODEL=""

# Restaurant nutrition provider — OPTIONAL (vendor-agnostic; concrete vendor is deployment config)
RESTAURANT_NUTRITION_API_KEY=""
RESTAURANT_NUTRITION_API_BASE_URL=""
